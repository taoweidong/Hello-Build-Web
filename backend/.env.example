# 后端环境变量模板：复制为 backend/.env 后按需修改（.env 已 gitignore，切勿提交）
# 安全提示：生产环境必须更换 SECRET_KEY / JWT_SIGNING_KEY，并显式收紧 ALLOWED_HOSTS 与 CORS。

# 调试模式（生产必须 false）
DEBUG=true

# Django 密钥（生产必须更换为随机长字符串）
SECRET_KEY=change-me-in-production

# JWT 签名密钥（未配置时回退 SECRET_KEY；生产建议独立配置）
JWT_SIGNING_KEY=

# 允许的主机，逗号分隔（生产必须配置实际域名，默认 * 仅用于本地开发）
ALLOWED_HOSTS=*

# CORS：true 表示放开全部来源（仅限本地联调）；生产用 CORS_ALLOWED_ORIGINS 白名单
CORS_ALLOW_ALL_ORIGINS=false
# CORS_ALLOWED_ORIGINS=http://localhost:8848,http://127.0.0.1:8848

# 业务参数
BUILD_MINUTES=30
PUSH_MINUTES=20
SYNC_BUFFER_MINUTES=20
ACCESS_TOKEN_EXPIRE_MINUTES=480

# 初始超管（seed 命令使用；生产部署后立即改密）
FIRST_SUPERUSER=admin
FIRST_SUPERUSER_PASSWORD=123456
