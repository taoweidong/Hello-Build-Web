# 单元测试环境（vitest 默认 mode=test 加载，不影响生产构建）
# 仅放公开环境变量；避免 router/index.ts 顶层 createRouter 在导入期
# 因 VITE_ROUTER_HISTORY 缺失而崩溃（生产该变量在 .env.development 等）

# 开发/测试读取配置文件路径
VITE_PUBLIC_PATH = /

# 路由历史模式（与 .env.development 保持一致，使用 Hash 模式）
VITE_ROUTER_HISTORY = "hash"

# 后端 API 基址
VITE_API_BASE_URL = http://localhost:8000/api

# 是否隐藏首页
VITE_HIDE_HOME = "false"
